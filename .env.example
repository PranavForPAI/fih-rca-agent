# ─── LLM Provider ────────────────────────────────────────────────────────────
# Provider: "gemini" or "anthropic" (optional, auto-detected if one key is set)
# LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=AIzaSy...
# or GOOGLE_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Agent guardrails ─────────────────────────────────────────────────────────
# Maximum rows returned per SQL query (LIMIT injected if not present)
MAX_ROWS=500

# Maximum LLM API round-trips per chat turn (prevents runaway loops)
MAX_TOOL_CALLS=20

# ─── Storage ──────────────────────────────────────────────────────────────────
# Directory for cached schema profiles (JSON files)
PROFILES_DIR=schema_profiles

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─── Example DSNs (never commit real credentials) ────────────────────────────
# Main onboarding DSN (schema owner / superuser)
# ONBOARD_DSN=postgresql://postgres:password@localhost:5432/mydb

# Read-only agent DSN (dedicated rca_agent role — see README for setup SQL)
# AGENT_DSN=postgresql://rca_agent:agentpass@localhost:5432/mydb
